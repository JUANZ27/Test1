            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="ruc" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Random

def random = new Random()

// Prefijo SUNAT (10 = persona natural)
def prefix = &quot;20&quot;

// Generar 8 dígitos aleatorios
def base = (1..8).collect { random.nextInt(10) }.join()

def rucBase = prefix + base

// Pesos SUNAT módulo 11
def weights = [5,4,3,2,7,6,5,4,3,2]

// Calcular suma
int sum = 0
for (int i = 0; i &lt; weights.size(); i++) {
    sum += Character.getNumericValue(rucBase.charAt(i)) * weights[i]
}

// Calcular dígito verificador
int remainder = sum % 11
int checkDigit = 11 - remainder

if (checkDigit == 10) {
    checkDigit = 0
} else if (checkDigit == 11) {
    checkDigit = 1
}

// RUC final
//def ruc = rucBase + checkDigit
def ruc = &quot;20573044054&quot;


// Guardar variable
vars.put(&quot;ruc&quot;, ruc)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
